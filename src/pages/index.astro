    <script is:inline>
      (() => {
        const root = document.documentElement;
        const hero = document.querySelector("[data-scroll-hero]");
        const image = document.querySelector("[data-scroll-hero-image]");

        if (!hero || !image) return;

        function clamp(value, min, max) {
          return Math.min(Math.max(value, min), max);
        }

        function updateHeroEffect() {
          const progress = clamp(window.scrollY / 360, 0, 1);

          root.style.setProperty("--hero-scale", String(1 + progress * 0.07));
          root.style.setProperty("--hero-blur", `${progress * 12}px`);
          root.style.setProperty("--hero-image-opacity", String(1 - progress * 0.1));
          root.style.setProperty("--hero-content-opacity", String(1 - progress * 0.48));
          root.style.setProperty("--hero-content-y", `${progress * -24}px`);
          root.style.setProperty("--hero-overlay-opacity", String(0.86 + progress * 0.08));
          root.style.setProperty("--hero-wash-opacity", String(progress * 0.16));
        }

        updateHeroEffect();
        window.addEventListener("scroll", updateHeroEffect, { passive: true });
        window.addEventListener("resize", updateHeroEffect);
      })();
    </script>
