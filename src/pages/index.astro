      const toggle = document.querySelector("[data-lang-toggle]");
      let currentLang = "en";

      function setLanguage(lang) {
        currentLang = lang;
        document.documentElement.lang = lang;

        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (key && translations[lang][key]) node.textContent = translations[lang][key];
        });

        document.querySelectorAll("[data-en][data-es]").forEach((node) => {
          const text = node.getAttribute(lang === "en" ? "data-en" : "data-es");
          if (text) node.textContent = text;
        });

        document.querySelectorAll("[data-placeholder-en][data-placeholder-es]").forEach((node) => {
          const text = node.getAttribute(lang === "en" ? "data-placeholder-en" : "data-placeholder-es");
          if (text) node.setAttribute("placeholder", text);
        });

        if (toggle) toggle.textContent = lang === "en" ? "ES" : "EN";
      }

      toggle?.addEventListener("click", () => setLanguage(currentLang === "en" ? "es" : "en"));

      function getFormValue(form, name) {
        const data = new FormData(form);
        return String(data.get(name) || "").trim();
      }

      function formatDateForMessage(dateValue, lang) {
        if (!dateValue) return lang === "es" ? "No indicada" : "Not provided";
        const [year, month, day] = dateValue.split("-").map(Number);
        const date = new Date(year, month - 1, day);

        return new Intl.DateTimeFormat(lang === "es" ? "es-CR" : "en-US", {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        }).format(date);
      }

      function bookingMessage(form, lang) {
        const name = getFormValue(form, "name");
        const date = getFormValue(form, "date");
        const guests = getFormValue(form, "guests");
        const location = getFormValue(form, "location");
        const details = getFormValue(form, "details");

        const lines =
          lang === "es"
            ? [
                "Hola Jose Luis, quiero consultar disponibilidad para una experiencia de chef privado.",
                "",
                `Nombre: ${name}`,
                `Fecha: ${formatDateForMessage(date, lang)}`,
                `Cantidad de personas: ${guests}`,
                `Ubicacion: ${location}`,
                "",
                "Detalles de la experiencia:",
                details || "Sin detalles adicionales por ahora.",
                "",
                "Quedo atento/a a tu disponibilidad y propuesta. Gracias.",
              ]
            : [
                "Hi Jose Luis, I would like to check availability for a private chef experience.",
                "",
                `Name: ${name}`,
                `Date: ${formatDateForMessage(date, lang)}`,
                `Guest count: ${guests}`,
                `Location: ${location}`,
                "",
                "Experience details:",
                details || "No extra details yet.",
                "",
                "I look forward to your availability and proposal. Thank you.",
              ];

        return lines.join("\n");
      }

      function reviewMessage(form, lang) {
        const name = getFormValue(form, "name");
        const rating = getFormValue(form, "rating");
        const favorite = getFormValue(form, "favorite");
        const review = getFormValue(form, "review");
        const ratingNumber = Number(rating) || 5;
        const fullStars = Math.floor(ratingNumber);
        const hasHalfStar = ratingNumber % 1 !== 0;
        const stars = `${"\u2605".repeat(fullStars)}${hasHalfStar ? "\u00BD" : ""}`;

        const lines =
          lang === "es"
            ? [
                "Hola Jose Luis, quiero dejar una resena de la experiencia.",
                "",
                `Nombre: ${name}`,
                `Calificacion: ${stars} (${rating}/5)`,
                `Parte favorita: ${favorite}`,
                "",
                "Resena:",
                review,
              ]
            : [
                "Hi Jose Luis, I would like to leave a review of the experience.",
                "",
                `Name: ${name}`,
                `Rating: ${stars} (${rating}/5)`,
                `Favorite part: ${favorite}`,
                "",
                "Review:",
                review,
              ];

        return lines.join("\n");
      }

      const bookingDateInput = document.querySelector("[data-booking-date]");

      function getTodayDateValue() {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, "0");
        const day = String(today.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      }

      function setBookingDateLimit() {
        if (!bookingDateInput) return;
        const today = getTodayDateValue();
        bookingDateInput.min = today;

        if (bookingDateInput.value && bookingDateInput.value < today) {
          bookingDateInput.value = "";
        }
      }

      setBookingDateLimit();

      bookingDateInput?.addEventListener("input", () => {
        bookingDateInput.setCustomValidity("");
