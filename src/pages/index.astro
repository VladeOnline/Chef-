          contactKicker: "Reservas",
          contactTitle: "Cuentanos sobre tu experiencia de chef privado.",
          contactCopy: "Envia fecha, ubicacion, numero de invitados y preferencias. Responderemos con disponibilidad y una propuesta personalizada.",
          areas: "Servicio para villas, casas y espacios privados en Costa Rica.",
          location: "Ubicacion: Costa Rica",
          bookingFormTitle: "Solicitar fecha",
          bookingButton: "Enviar por WhatsApp",
          reviewFormTitle: "Dejar una resena",
          reviewButton: "Enviar resena",
          footerText: "Cenas privadas, eventos, menus wellness y resenas de clientes.",
        },
      };

      const toggle = document.querySelector("[data-lang-toggle]");
      let currentLang = "en";

      function setLanguage(lang) {
        currentLang = lang;
        document.documentElement.lang = lang;

        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (key && translations[lang][key]) node.textContent = translations[lang][key];
        });

        document.querySelectorAll("[data-en][data-es]").forEach((node) => {
          const text = node.getAttribute(lang === "en" ? "data-en" : "data-es");
          if (text) node.textContent = text;
        });

        document.querySelectorAll("[data-placeholder-en][data-placeholder-es]").forEach((node) => {
          const text = node.getAttribute(lang === "en" ? "data-placeholder-en" : "data-placeholder-es");
          if (text) node.setAttribute("placeholder", text);
        });

        if (toggle) toggle.textContent = lang === "en" ? "ES" : "EN";
      }

      toggle?.addEventListener("click", () => setLanguage(currentLang === "en" ? "es" : "en"));

      function formToMessage(form, title) {
        const data = new FormData(form);
        const lines = [title];
        for (const [key, value] of data.entries()) {
          if (String(value).trim()) lines.push(`${key}: ${value}`);
        }
        return lines.join("\n");
      }

      document.querySelector("[data-booking-form]")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const message = formToMessage(event.currentTarget, currentLang === "en" ? "Private chef booking request" : "Solicitud de chef privado");
        window.open(`https://wa.me/50600000000?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
      });

      document.querySelector("[data-review-form]")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const message = formToMessage(event.currentTarget, currentLang === "en" ? "Guest review" : "Resena de cliente");
        window.open(`https://wa.me/50600000000?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
      });

      const galleryTrack = document.querySelector("[data-public-gallery]");
      const galleryDots = document.querySelector("[data-gallery-dots]");
      const galleryPrev = document.querySelector("[data-gallery-prev]");
      const galleryNext = document.querySelector("[data-gallery-next]");
      let galleryIndex = 0;
      let galleryTimer;

      function getGallerySlides() {
        return Array.from(galleryTrack?.children || []);
      }

      function getVisibleGalleryCount() {
        if (window.matchMedia("(min-width: 1024px)").matches) return 3;
        if (window.matchMedia("(min-width: 768px)").matches) return 2;
        return 1;
      }

      function getMaxGalleryIndex() {
        return Math.max(getGallerySlides().length - getVisibleGalleryCount(), 0);
      }

      function getGalleryStep() {
        const firstSlide = getGallerySlides()[0];
        if (!firstSlide || !galleryTrack) return 0;
        const gap = Number.parseFloat(window.getComputedStyle(galleryTrack).columnGap || "0");
        return firstSlide.getBoundingClientRect().width + gap;
      }

      function renderGalleryDots() {
        if (!galleryDots) return;
        const maxIndex = getMaxGalleryIndex();
        galleryDots.innerHTML = "";

        for (let index = 0; index <= maxIndex; index += 1) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "h-2.5 w-2.5 rounded-full bg-ink/25 transition hover:bg-forest";
          button.setAttribute("aria-label", `Go to gallery photo ${index + 1}`);
          button.addEventListener("click", () => {
            showGallerySlide(index);
            restartGalleryAutoplay();
          });
          galleryDots.appendChild(button);
        }

        galleryDots.classList.toggle("hidden", maxIndex === 0);
        galleryPrev?.classList.toggle("hidden", maxIndex === 0);
        galleryNext?.classList.toggle("hidden", maxIndex === 0);
      }

      function showGallerySlide(index) {
        if (!galleryTrack || getGallerySlides().length === 0) return;
        const maxIndex = getMaxGalleryIndex();

        galleryIndex = maxIndex === 0 ? 0 : (index + maxIndex + 1) % (maxIndex + 1);
        galleryTrack.style.transform = `translateX(-${galleryIndex * getGalleryStep()}px)`;

        Array.from(galleryDots?.children || []).forEach((dot, dotIndex) => {
          dot.className =
            dotIndex === galleryIndex
              ? "h-2.5 w-8 rounded-full bg-forest transition"
              : "h-2.5 w-2.5 rounded-full bg-ink/25 transition hover:bg-forest";
        });
      }

      function startGalleryAutoplay() {
        window.clearInterval(galleryTimer);
        if (getMaxGalleryIndex() === 0) return;
        galleryTimer = window.setInterval(() => {
          showGallerySlide(galleryIndex + 1);
        }, 4500);
      }

      function restartGalleryAutoplay() {
        startGalleryAutoplay();
      }

      galleryPrev?.addEventListener("click", () => {
        showGallerySlide(galleryIndex - 1);
        restartGalleryAutoplay();
      });

      galleryNext?.addEventListener("click", () => {
        showGallerySlide(galleryIndex + 1);
        restartGalleryAutoplay();
      });

      renderGalleryDots();
      showGallerySlide(0);
      startGalleryAutoplay();

      window.addEventListener("resize", () => {
        galleryIndex = Math.min(galleryIndex, getMaxGalleryIndex());
        renderGalleryDots();
        showGallerySlide(galleryIndex);
        restartGalleryAutoplay();
      });

      async function loadPublishedGallery() {
        const grid = document.querySelector("[data-public-gallery]");
        const status = document.querySelector("[data-gallery-status]");

        if (!grid || !supabaseUrl || !supabaseAnonKey) return;

        const supabase = createClient(supabaseUrl, supabaseAnonKey);
        const { data, error } = await supabase
          .from(galleryTable)
          .select("image_url, alt_text, sort_order, created_at")
          .order("sort_order", { ascending: true })
          .order("created_at", { ascending: false });

        if (error) {
          if (status) {
            status.textContent = "Gallery is using local photos while the live gallery is unavailable.";
            status.classList.remove("hidden");
          }
          return;
        }

        if (!data || data.length === 0) return;

        grid.innerHTML = "";
        data.forEach((image) => {
          const figure = document.createElement("figure");
          const img = document.createElement("img");
          figure.className = "min-w-full rounded-lg bg-white p-3 shadow-sm md:min-w-[calc(50%_-_0.625rem)] lg:min-w-[calc(33.333%_-_0.875rem)]";
          img.className = "h-80 w-full rounded-md object-cover";
          img.src = image.image_url;
          img.alt = image.alt_text || "Private chef Costa Rica gallery photo";
          img.loading = "lazy";
          figure.appendChild(img);
          grid.appendChild(figure);
        });

        galleryIndex = 0;
        renderGalleryDots();
        showGallerySlide(0);
        startGalleryAutoplay();
      }

      loadPublishedGallery();
    </script>
  </body>
</html>
