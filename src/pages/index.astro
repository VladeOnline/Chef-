      document.querySelector("[data-booking-form]")?.addEventListener("submit", (event) => {
        event.preventDefault();
        setBookingDateLimit();

        if (bookingDateInput?.value && bookingDateInput.value < getTodayDateValue()) {
          const activeLang = document.documentElement.lang === "es" ? "es" : "en";
          bookingDateInput.setCustomValidity(
            activeLang === "es"
              ? "Selecciona una fecha de hoy en adelante."
              : "Please select today or a future date.",
          );
          bookingDateInput.reportValidity();
          return;
        }

        const activeLang = document.documentElement.lang === "es" ? "es" : "en";
        const message = bookingMessage(event.currentTarget, activeLang);
        window.open(`https://wa.me/50686584625?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
      });

      document.querySelector("[data-review-form]")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const activeLang = document.documentElement.lang === "es" ? "es" : "en";
        const message = reviewMessage(event.currentTarget, activeLang);
        window.open(`https://wa.me/50686584625?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
      });

      const ratingRoot = document.querySelector("[data-star-rating]");
      const ratingInput = document.querySelector("[data-rating-input]");
      const ratingValue = document.querySelector("[data-rating-value]");
      const ratingStars = Array.from(document.querySelectorAll("[data-rating-star]"));
      let selectedRating = Number(ratingInput?.value || 5);

      function paintRating(value) {
        ratingStars.forEach((starButton, index) => {
          const starNumber = index + 1;
          const fill = Math.max(0, Math.min(1, value - (starNumber - 1)));
          starButton.style.setProperty("--star-fill", `${fill * 100}%`);
          starButton.setAttribute("aria-checked", fill > 0 ? "true" : "false");
        });

        if (ratingInput) ratingInput.value = String(value);
        if (ratingValue) ratingValue.textContent = `${value}/5`;
      }

      function getRatingFromPointer(event, starButton) {
        const starNumber = Number(starButton.dataset.ratingStar || 1);
        const rect = starButton.getBoundingClientRect();
        const isHalf = event.clientX - rect.left <= rect.width / 2;
        return starNumber - (isHalf ? 0.5 : 0);
      }

      ratingStars.forEach((starButton) => {
        starButton.addEventListener("pointermove", (event) => {
          paintRating(getRatingFromPointer(event, starButton));
        });

        starButton.addEventListener("click", (event) => {
          selectedRating = getRatingFromPointer(event, starButton);
          paintRating(selectedRating);
        });

        starButton.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          selectedRating = Math.max(0.5, Math.min(5, selectedRating + (event.key === "ArrowRight" ? 0.5 : -0.5)));
          paintRating(selectedRating);
        });
      });

      ratingRoot?.addEventListener("pointerleave", () => {
        paintRating(selectedRating);
      });

      paintRating(selectedRating);

      const galleryTrack = document.querySelector("[data-public-gallery]");
      const galleryDots = document.querySelector("[data-gallery-dots]");
      const galleryPrev = document.querySelector("[data-gallery-prev]");
      const galleryNext = document.querySelector("[data-gallery-next]");
      let galleryIndex = 0;
      let galleryTimer;

      function getGallerySlides() {
        return Array.from(galleryTrack?.children || []);
      }

      function getVisibleGalleryCount() {
        if (window.matchMedia("(min-width: 1024px)").matches) return 3;
        if (window.matchMedia("(min-width: 768px)").matches) return 2;
        return 1;
      }

      function getMaxGalleryIndex() {
        return Math.max(getGallerySlides().length - getVisibleGalleryCount(), 0);
      }

      function getGalleryStep() {
        const firstSlide = getGallerySlides()[0];
        if (!firstSlide || !galleryTrack) return 0;
        const gap = Number.parseFloat(window.getComputedStyle(galleryTrack).columnGap || "0");
        return firstSlide.getBoundingClientRect().width + gap;
      }

      function renderGalleryDots() {
        if (!galleryDots) return;
        const maxIndex = getMaxGalleryIndex();
        galleryDots.innerHTML = "";

        for (let index = 0; index <= maxIndex; index += 1) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "h-2.5 w-2.5 rounded-full bg-ink/25 transition hover:bg-forest";
          button.setAttribute("aria-label", `Go to gallery photo ${index + 1}`);
          button.addEventListener("click", () => {
            showGallerySlide(index);
            restartGalleryAutoplay();
          });
          galleryDots.appendChild(button);
        }

        galleryDots.classList.toggle("hidden", maxIndex === 0);
        galleryPrev?.classList.toggle("hidden", maxIndex === 0);
        galleryNext?.classList.toggle("hidden", maxIndex === 0);
      }

      function showGallerySlide(index) {
        if (!galleryTrack || getGallerySlides().length === 0) return;
        const maxIndex = getMaxGalleryIndex();

        galleryIndex = maxIndex === 0 ? 0 : (index + maxIndex + 1) % (maxIndex + 1);
        galleryTrack.style.transform = `translateX(-${galleryIndex * getGalleryStep()}px)`;

        Array.from(galleryDots?.children || []).forEach((dot, dotIndex) => {
          dot.className =
            dotIndex === galleryIndex
              ? "h-2.5 w-8 rounded-full bg-forest transition"
              : "h-2.5 w-2.5 rounded-full bg-ink/25 transition hover:bg-forest";
        });
      }

      function startGalleryAutoplay() {
        window.clearInterval(galleryTimer);
        if (getMaxGalleryIndex() === 0) return;
        galleryTimer = window.setInterval(() => {
          showGallerySlide(galleryIndex + 1);
        }, 4500);
      }

      function restartGalleryAutoplay() {
        startGalleryAutoplay();
      }

      galleryPrev?.addEventListener("click", () => {
        showGallerySlide(galleryIndex - 1);
        restartGalleryAutoplay();
      });

      galleryNext?.addEventListener("click", () => {
        showGallerySlide(galleryIndex + 1);
        restartGalleryAutoplay();
      });

      renderGalleryDots();
      showGallerySlide(0);
      startGalleryAutoplay();

      window.addEventListener("resize", () => {
        galleryIndex = Math.min(galleryIndex, getMaxGalleryIndex());
        renderGalleryDots();
        showGallerySlide(galleryIndex);
        restartGalleryAutoplay();
      });

      const reviewMarquee = document.querySelector("[data-review-marquee]");
      let reviewScrollTimer;
      let reviewPauseTimer;

      function startReviewMarquee() {
        if (!reviewMarquee || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        window.clearInterval(reviewScrollTimer);
        reviewScrollTimer = window.setInterval(() => {
          const maxScroll = reviewMarquee.scrollHeight - reviewMarquee.clientHeight;
          if (maxScroll <= 0) return;

          if (reviewMarquee.scrollTop >= maxScroll - 1) {
            window.clearInterval(reviewScrollTimer);
            window.clearTimeout(reviewPauseTimer);
            reviewPauseTimer = window.setTimeout(() => {
              reviewMarquee.scrollTo({ top: 0, behavior: "auto" });
              window.setTimeout(startReviewMarquee, 900);
            }, 2400);
            return;
          }

          reviewMarquee.scrollTop += 1;
        }, 36);
      }

      function pauseReviewMarquee() {
        window.clearInterval(reviewScrollTimer);
        window.clearTimeout(reviewPauseTimer);
        reviewPauseTimer = window.setTimeout(startReviewMarquee, 2200);
      }

      reviewMarquee?.addEventListener("wheel", pauseReviewMarquee, { passive: true });
      reviewMarquee?.addEventListener("touchstart", pauseReviewMarquee, { passive: true });
      reviewMarquee?.addEventListener("mouseenter", pauseReviewMarquee);
      reviewMarquee?.addEventListener("mouseleave", startReviewMarquee);
      startReviewMarquee();

      const revealCards = document.querySelectorAll(".reveal-card");

      if (revealCards.length > 0 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("reveal-enabled");

        if ("IntersectionObserver" in window) {
          window.requestAnimationFrame(() => {
            const revealObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (!entry.isIntersecting) return;
                  entry.target.classList.add("is-visible");
                  revealObserver.unobserve(entry.target);
                });
              },
              { threshold: 0.28, rootMargin: "0px 0px -16% 0px" },
            );

            revealCards.forEach((card) => revealObserver.observe(card));
          });
        } else {
          revealCards.forEach((card) => card.classList.add("is-visible"));
        }
      }

      async function loadPublishedGallery() {
        const grid = document.querySelector("[data-public-gallery]");
        const status = document.querySelector("[data-gallery-status]");

        if (!grid || !supabaseUrl || !supabaseAnonKey) return;

        const supabase = createClient(supabaseUrl, supabaseAnonKey);
        const { data, error } = await supabase
          .from(galleryTable)
          .select("image_url, alt_text, sort_order, created_at")
          .order("sort_order", { ascending: true })
          .order("created_at", { ascending: false });

        if (error) {
          if (status) {
            status.textContent = "Gallery is using local photos while the live gallery is unavailable.";
            status.classList.remove("hidden");
          }
          return;
        }

        if (!data || data.length === 0) return;

        grid.innerHTML = "";
        data.forEach((image) => {
          const figure = document.createElement("figure");
          const img = document.createElement("img");
          figure.className = "min-w-full rounded-lg bg-white p-3 shadow-sm md:min-w-[calc(50%_-_0.625rem)] lg:min-w-[calc(33.333%_-_0.875rem)]";
          img.className = "h-80 w-full rounded-md object-cover";
          img.src = image.image_url;
          img.alt = image.alt_text || "Private chef Costa Rica gallery photo";
          img.loading = "lazy";
          figure.appendChild(img);
          grid.appendChild(figure);
        });

        galleryIndex = 0;
        renderGalleryDots();
        showGallerySlide(0);
        startGalleryAutoplay();
      }

      loadPublishedGallery();
    </script>
