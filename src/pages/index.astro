      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const revealCards = Array.from(document.querySelectorAll(".reveal-card"));

        if (reduceMotion || revealCards.length === 0) return;

        document.documentElement.classList.add("reveal-enabled");
        revealCards.forEach((card) => card.classList.remove("is-visible"));

        const showCard = (card) => {
          card.classList.add("is-visible");
        };

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            if ("IntersectionObserver" in window) {
              const observer = new IntersectionObserver(
                (entries) => {
                  entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    showCard(entry.target);
                    observer.unobserve(entry.target);
                  });
                },
                { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
              );

              revealCards.forEach((card) => observer.observe(card));
              return;
            }

            revealCards.forEach(showCard);
          });
        });
      })();
    </script>

